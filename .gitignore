.venv/
venv/
ENV/
env/
python_portable/

# Demo data is committed on purpose: database/catalog.db and uploads/ hold made-up tools and drawings,
# so a fresh clone runs with data straight away. What stays out is anything the app generates per
# install - the Flask secret key, SQLite's WAL/journal files and the thumbnail cache.
database/*
!database/catalog.db
*.db-wal
*.db-shm
*.db-journal
uploads/thumbs/

# IDE / Editor configuration
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
